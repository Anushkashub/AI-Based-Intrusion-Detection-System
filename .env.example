# ============================================================
# AI-BASED INTRUSION DETECTION SYSTEM (AI-IDS)
# Environment Configuration Template
# Copy this file to .env and adjust variables as needed
# ============================================================

# Flask Secret Key for cryptographic session signing (Change in production!)
SECRET_KEY=change-this-to-a-secure-random-secret-key

# SOC Dashboard Administrator Credentials (Set your secure credentials)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Web Server Binding Configuration
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=false

# Optional Alert Notification Settings
ADMIN_EMAIL=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
